{
  "schema_version": 1,
  "description": "Fixed SourceRudder search quality corpus (S11). expect_any: case-insensitive substrings; a case hits when any result URL in the top k contains one.",
  "cases": [
    {
      "id": "web-go-context",
      "tool": "search_web",
      "arguments": {
        "query": "Go context package cancellation",
        "maxResults": 10
      },
      "k": 5,
      "expect_any": [
        "pkg.go.dev/context",
        "go.dev/blog/context"
      ],
      "note": "Official Go package docs or the Go blog post."
    },
    {
      "id": "web-docker-healthcheck",
      "tool": "search_web",
      "arguments": {
        "query": "Dockerfile HEALTHCHECK instruction",
        "maxResults": 10
      },
      "k": 5,
      "expect_any": [
        "docs.docker.com"
      ],
      "note": "Official Docker reference."
    },
    {
      "id": "web-python-asyncio",
      "tool": "search_web",
      "arguments": {
        "query": "python asyncio documentation",
        "maxResults": 10
      },
      "k": 5,
      "expect_any": [
        "docs.python.org/3/library/asyncio"
      ],
      "note": "Official asyncio library docs."
    },
