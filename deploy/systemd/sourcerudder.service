[Unit]
Description=SourceRudder MCP Server
After=network.target

[Service]
Type=simple
User=sourcerudder
EnvironmentFile=/etc/sourcerudder/sourcerudder.env
# Identity check: refuse to start if the on-disk VERSION/IMAGE do
# not contain the exact values the operator committed in source.
# `grep -qxF 'expected' /opt/sourcerudder/VERSION` compares the FILE
# CONTENTS against the literal expected token — NOT a second file
# path. The previous `cmp -s FILE @VERSION@` shape compared two
# FILE PATHS, so after substitution the expected token became a
# path operand and the check was meaningless. Mismatches abort the
# start so a half-rolled host cannot pass `systemctl is-active`
# while serving a stale binary.
ExecStartPre=/bin/sh -c '/usr/bin/test -f /opt/sourcerudder/VERSION && /usr/bin/test -f /opt/sourcerudder/IMAGE && /usr/bin/grep -qxF @VERSION@ /opt/sourcerudder/VERSION || (echo "VERSION mismatch: /opt/sourcerudder/VERSION does not contain expected token"; exit 1)'
ExecStartPre=/bin/sh -c '/usr/bin/grep -qxF @IMAGE@ /opt/sourcerudder/IMAGE || (echo "IMAGE mismatch: /opt/sourcerudder/IMAGE does not contain expected token"; exit 1)'
ExecStartPre=/bin/sh -c '/usr/bin/test -f /etc/sourcerudder/release/BINARY_SHA256 && /usr/bin/sha256sum -c /etc/sourcerudder/release/BINARY_SHA256 || (echo "binary checksum mismatch"; exit 1)'
ExecStart=/opt/sourcerudder/bin/sourcerudder -transport http -http-addr 127.0.0.1:8080 -searxng-url http://localhost:8888
# This unit is the host-managed always-on MCP endpoint.
Restart=always
RestartSec=5

# Bound the always-on host service and prevent privilege expansion.
MemoryMax=512M
MemorySwapMax=512M
CPUQuota=50%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/sourcerudder /etc/sourcerudder/release
CapabilityBoundingSet=
RestrictSUIDSGID=true

Environment=SEARXNG_URL=http://localhost:8888
Environment=FETCH_TIMEOUT_MS=30000
Environment=FETCH_USER_AGENT=SourceRudder/@VERSION@
Environment=FETCH_MAX_REDIRECTS=5
Environment=FETCH_MAX_ATTEMPTS=3
Environment=LOCAL_INDEX_PATH=
# YouTube transcripts (see deploy/youtube/). yt-dlp runs with --no-cache-dir and
# writes under the private /tmp, so no extra write path is needed. MemoryMax is
# unchanged: yt-dlp (python) and node run inside this cgroup but only briefly.
# MemoryDenyWriteExecute stays unset because the node JS runtime needs a JIT.
Environment=YTDLP_PATH=/opt/yt-dlp/bin/yt-dlp
Environment=YTDLP_JS_RUNTIMES=node:/opt/nodejs/bin/node
Environment=YOUTUBE_POT_BASE_URL=http://127.0.0.1:4416

[Install]
WantedBy=multi-user.target
